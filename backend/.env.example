# Entorno
NODE_ENV=development

# Servidor
SERVER_PORT=5560
API_GLOBAL_PREFIX=api

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=heavycult_user
DB_PASSWORD=cambia_esta_contrasena
DB_DATABASE=heavycult
# Solo para desarrollo rápido. En producción usa migraciones (false).
DB_SYNCHRONIZE=false

# JWT
# Genera secretos largos: openssl rand -hex 32
JWT_SECRET=genera_un_secreto_de_64_hex
JWT_RECOVERY_SECRET=genera_otro_secreto_de_64_hex
JWT_EXPIRES_IN_SECONDS=3600
JWT_RECOVERY_EXPIRES_IN_SECONDS=300

# Cookies
COOKIE_SECURE=false
COOKIE_MAX_AGE_SECONDS=3600

# Frontend
FRONTEND_URL=http://localhost:3000

# Seguridad de contraseñas
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Códigos de recuperación
TOKEN_EXPIRES_MINUTES=10
TOKEN_MAX_ATTEMPTS=5

# Correo (Brevo). Vacío = simulación de envío en desarrollo.
# Obtén tu API key en https://app.brevo.com
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=HeavyCult <no-reply@heavycult.com>

# Cloudinary (fotos de perfil)
# Consíguelas en https://console.cloudinary.com → Account → API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# WhatsApp / Evolution API
# La conexión real también puede configurarse desde el panel web (Configuración → WhatsApp).
# Si usas Docker (docker compose up -d):
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=heavycult_evolution_secret_key_2026
# En desarrollo local con Docker, el webhook debe apuntar al host de la máquina:
EVOLUTION_WEBHOOK_PUBLIC_URL=http://host.docker.internal:5560/api/whatsapp/webhooks/evolution
EVOLUTION_TIMEOUT_MS=15000

# Seed del usuario administrador (se ejecuta al arrancar)
ADMIN_NOMBRE=HeavyCult
ADMIN_APELLIDO=Admin
ADMIN_EMAIL=admin@heavycult.co
ADMIN_PASSWORD=CambiaEstaPassword2026!
ADMIN_TELEFONO=